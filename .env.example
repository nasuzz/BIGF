DATABASE_URL=postgresql://user:password@db:5432/product_finder
CLOVA_API_KEY=
CLOVA_ENDPOINT=https://clovastudio.stream.ntruss.com
MODEL_NAME=HCX-005
REQUEST_TIMEOUT=50
HCX_TIMEOUT=20
HCX_MAX_TOKENS=800
DATA_VERSION=data_v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_BATCH_SIZE=8

# docker-compose db service (pgvector/pgvector) init credentials —
# must match the user/password/db name embedded in DATABASE_URL above
POSTGRES_DB=product_finder
POSTGRES_USER=user
POSTGRES_PASSWORD=password
